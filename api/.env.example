DATABASE_URL=postgres://carpentry:localdevpassword@localhost:5432/carpentry_dev
PORT=3001

# Origin of the web app, for CORS
WEB_ORIGIN=http://localhost:5173

# Keycloak (see docker-compose.yml's `keycloak` service and keycloak/import/carpentry-realm.json).
# Every request must carry a valid Authorization: Bearer token from this realm — see
# src/middleware/auth.ts. Business identity comes from the token's group membership
# (/businesses/<id>), not a header, so there's no more X-Business-Id/DEFAULT_BUSINESS_ID.
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=carpentry
KEYCLOAK_CLIENT_ID=web-app

# Bootstrap-admin credentials (matches KC_BOOTSTRAP_ADMIN_USERNAME/PASSWORD in
# docker-compose.yml), used only server-to-server by src/lib/keycloak-admin.ts to provision a
# new business's Keycloak group + owner user from POST /api/businesses. Never used for
# end-user login.
KEYCLOAK_PROVISIONER_USERNAME=admin
KEYCLOAK_PROVISIONER_PASSWORD=
