DATABASE_URL=postgres://carpentry:localdevpassword@localhost:5432/carpentry_dev
PORT=3001

# Origin of the web app, for CORS
WEB_ORIGIN=http://localhost:5173

 # No login system yet — every request resolves to this business unless it sends an
# X-Business-Id header instead. Matches the row seeded by
# migrations/0001_add_multi_tenancy.sql (Acme Carpentry). See src/middleware/tenant.ts.
DEFAULT_BUSINESS_ID=00000000-0000-0000-0000-000000000001

# Shared secret for POST/GET /api/businesses (create/list tenants) — send as an X-Admin-Key
# header. Separate boundary from DEFAULT_BUSINESS_ID/X-Business-Id: that says "act as this
# business", this says "manage businesses themselves". See src/middleware/admin.ts. Set this
# to a real random value locally — there is no safe default.
ADMIN_API_KEY=
