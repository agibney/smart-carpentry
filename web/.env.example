# Base URL of the api/ Express server. Read server-side only (in loaders/actions via
# app/lib/api.ts) — never bundled to the browser.
API_BASE_URL=http://localhost:3001

# Keycloak (see docker-compose.yml's `keycloak` service and keycloak/import/carpentry-realm.json).
# Used server-side only, in lib/auth.server.ts's OIDC (Authorization Code + PKCE) flow.
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=carpentry
KEYCLOAK_CLIENT_ID=web-app

# Signs the session cookie (lib/session.server.ts) — set to a real random value locally,
# there is no safe default.
SESSION_SECRET=change-me-locally

# This app's own public origin — used to build the Keycloak redirect_uri/post_logout_redirect_uri.
WEB_PUBLIC_URL=http://localhost:5173